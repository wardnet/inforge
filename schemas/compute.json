{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compute.json",
  "title": "Compute resource",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "container", "provider", "network", "size", "image"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["vm", "cluster"] },
    "container": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "network": { "type": "string", "minLength": 1 },
    "size": { "type": "string", "minLength": 1 },
    "image": { "type": "string", "enum": ["ubuntu-24.04", "ubuntu-26.04"] },
    "cloud_init": { "type": "string", "minLength": 1 },
    "instance_count": { "type": "integer", "minimum": 1 },
    "firewall": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inbound": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["proto", "port"],
            "properties": {
              "proto": { "type": "string", "enum": ["tcp", "udp", "icmp"] },
              "port": {
                "oneOf": [
                  { "type": "integer", "minimum": 1, "maximum": 65535 },
                  { "type": "string", "minLength": 1 }
                ]
              }
            }
          }
        }
      }
    },
    "deploy_user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    }
  }
}
