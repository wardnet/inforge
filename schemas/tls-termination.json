{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tls-termination.json",
  "title": "TLS termination resource",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "container", "provider", "compute"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "container": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "compute": { "type": "string", "minLength": 1, "description": "specKey of the host ComputeSpec the terminator runs on, e.g. bridge-01" }
  }
}
